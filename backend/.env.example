# Backend environment variables — copy to .env and fill in values

# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/agri_platform

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# IBM watsonx / Granite LLM (optional — app works without these)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# Demo mode — set to true to always use mock data regardless of DB/API state
DEMO_MODE=true

# Mandi API (optional — pluggable)
MANDI_API_KEY=
MANDI_API_URL=

# Upload directory for quality grading images
UPLOAD_DIR=./uploads
